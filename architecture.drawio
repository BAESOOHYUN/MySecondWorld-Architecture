        <mxCell id="c17" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Idle&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;대기&lt;/span&gt;" vertex="1">
