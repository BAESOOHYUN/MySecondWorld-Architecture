        </mxCell>
        <mxCell id="c21" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;" value="2 · 기능 모듈" vertex="1">
          <mxGeometry height="26" width="190" x="40" y="1027" as="geometry" />
        </mxCell>
        <mxCell id="c22" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;MySecondWorld.Character  (2파일)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;MovementController · PlayerAnimationController&lt;br&gt;참조: Utils · Foundation · Input&lt;/span&gt;" vertex="1">
