          <mxGeometry height="26" width="190" x="40" y="596" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;MySecondWorld.AI  (24파일)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;NPC 대화 · LLM · TTS · STT · 립싱크.&lt;br&gt;참조: ScriptableObject · Foundation · Input · Inventory.Items · Combat · Interaction · Camera&lt;/span&gt;" vertex="1">
