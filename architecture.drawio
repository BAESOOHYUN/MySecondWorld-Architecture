        <mxCell id="o2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;AvatarPartKeyTableSO — 파츠 번호표&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;파츠 번호 ↔ 프리팹(Addressables) ↔ 입으려면 필요한 아이템이 같은 번호로 짝지어 있다&lt;br&gt;0번은 맨몸이라 무료다&lt;/span&gt;" vertex="1">
