        <mxCell id="lr_note" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" value="▸ = 클래스.메서드 (클래스 : 부모 = 상속). 화살표 글씨 = 전달하는 방법" vertex="1">
