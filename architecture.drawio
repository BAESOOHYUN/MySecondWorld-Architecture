        <mxCell id="b3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Render Scale 0.77 + STP 업스케일링&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;77% 해상도로 그려 STP로 키운다&lt;/span&gt;" vertex="1">
