        <mxCell id="d2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;visible — 지금 화면에 보일 값&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ MutualExclusionResolver&lt;br&gt;.ComputeVisibleAppearance()&lt;br&gt;매번 desired만 보고 새로 계산한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="700" y="1600" as="geometry" />
        </mxCell>
