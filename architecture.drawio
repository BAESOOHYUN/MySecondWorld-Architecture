        <mxCell id="c14" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;NPC 대화 (클라이언트, NPCScope)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;NPCBrain · NPCInteractable&lt;br&gt;NPCVoicePlayer · NPCLipSyncController&lt;br&gt;ILLMService · ITTSService · ISTTService&lt;/span&gt;" vertex="1">
