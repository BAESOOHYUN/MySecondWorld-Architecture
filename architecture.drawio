        <mxCell id="c15" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;저장 (클라이언트)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;CharacterSaveService: 캐릭터 외형을 PlayerPrefs에 계정별로 저장&lt;/span&gt;" vertex="1">
          <mxGeometry height="87" width="340" x="60" y="541" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;리소스 로드 · 캐시 (클라이언트)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;AddressablesService (번들 · 씬 로드)&lt;br&gt;WebResourceService (L1 메모리 → L2 디스크 → L3 네트워크 캐시)&lt;/span&gt;" vertex="1">
