        <mxCell id="c4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;탭은 카메라 시점에서 쏜다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ Camera.main.ScreenPointToRay()&lt;br&gt;탭 좌표를 카메라 시점의&lt;br&gt;월드 광선으로 바꾼다&lt;/span&gt;" vertex="1">
          <mxGeometry height="122" width="340" x="780" y="635" as="geometry" />
        </mxCell>
        <mxCell id="ef4" edge="1" parent="1" source="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" target="c3" value="회전">
