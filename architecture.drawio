        <mxCell id="c37" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Addressables 원격 호스팅&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;카탈로그 + 번들 (필드 · 던전 씬, 파츠)&lt;br&gt;클라는 시작 시 번들 동기화&lt;/span&gt;" vertex="1">
