          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;결과: Batches 33,182 → 5,530 (약 83% 감소)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;데모 씬 기준 에디터 측정. 대부분은 GPU Resident Drawer와 Forward+&lt;br&gt;전환에서 나왔다 (33,182 → 5,600대). 삼각형은 약 970만으로 그대로다.&lt;br&gt;병목이 폴리곤이 아니었다는 확인이기도 하다&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="640" x="430" y="450" as="geometry" />
        </mxCell>
        <mxCell id="eA3" edge="1" parent="1" source="zG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="r1" value="결과">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;효과가 작았던 것도 남긴다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;머테리얼 GPU Instancing 7개: 5,618 → 5,666 (오차)&lt;br&gt;Occlusion Culling 베이크: 5,606 → 5,530 (소폭)&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="340" x="40" y="450" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;그 밖에 같이 정리한 것&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ DynamicsManager.asset&lt;br&gt;UI · PreviewCharacter · HLOD 레이어 충돌 검사를 껐다&lt;br&gt;URP 에셋의 Volume Profile이 None이면 포스트 프로세싱이 안 걸려서 DefaultVolumeProfile을 연결했다&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="510" x="1130" y="450" as="geometry" />
        </mxCell>
        <mxCell id="hB" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="B. 오브젝트 풀링 — 같은 객체를 빌려 쓰고 돌려준다 (Pool 어셈블리)" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="610" as="geometry" />
        </mxCell>
        <mxCell id="zR" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fillOpacity=28;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;GameObjectPoolRegistry&amp;lt;TKey&amp;gt; — 키 하나에 풀 하나&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;내부는 Dictionary&amp;lt;TKey, IGameObjectPool&amp;gt;. 쓰는 곳마다 키가 다르고, DisposeWhere로 조건에 맞는 풀만 정리한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="300" width="880" x="40" y="650" as="geometry" />
        </mxCell>
        <mxCell id="zPl" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fillOpacity=28;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;GameObjectPool : IGameObjectPool — Rent() → Get(), Return() → Release()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;일반 Instantiate 전용. Addressable 인스턴스와 섞으면 ReleaseInstance와 충돌해 샌다&lt;/span&gt;" vertex="1">
          <mxGeometry height="224" width="840" x="60" y="712" as="geometry" />
        </mxCell>
        <mxCell id="q3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;PooledObject&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Init(pool)로 소속 풀을 기억하고&lt;br&gt;ReturnToPool()로 스스로 반납한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="220" x="80" y="770" as="geometry" />
        </mxCell>
        <mxCell id="zUn" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fillOpacity=28;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;Unity ObjectPool&amp;lt;GameObject&amp;gt; — 안에서 List&amp;lt;T&amp;gt;를 스택처럼 쓴다&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;마지막에 돌려준 1개는 별도 칸에 두는 최적화가 있다&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="560" x="320" y="776" as="geometry" />
        </mxCell>
        <mxCell id="q1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Get()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;List 맨 뒤에서&lt;br&gt;꺼내 켠다. 비면&lt;br&gt;새로 만든다&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="170" x="340" y="830" as="geometry" />
        </mxCell>
        <mxCell id="q2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Release()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;꺼서 List 맨 뒤에&lt;br&gt;붙인다. maxSize를&lt;br&gt;넘으면 파괴한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="170" x="525" y="830" as="geometry" />
        </mxCell>
        <mxCell id="q4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;collectionCheck&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;List를 처음부터&lt;br&gt;훑어 이중 반납을&lt;br&gt;잡는다 (에디터)&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="150" x="710" y="830" as="geometry" />
        </mxCell>
        <mxCell id="zU" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E1D5E7;fillOpacity=28;strokeColor=#9673A6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;풀을 쓰는 곳 — 수명이 서로 다르다&lt;/span&gt;" vertex="1">
          <mxGeometry height="300" width="660" x="980" y="650" as="geometry" />
        </mxCell>
        <mxCell id="u1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;투사체 — 키는 (프리팹 ID, 씬 핸들) 튜플&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ ProjectilePool.Rent(prefab, scene)&lt;br&gt;던전이 Additive 씬이라 풀 수명을 씬에 묶는다.&lt;br&gt;sceneUnloaded에서 그 씬의 풀만 정리한다 (7페이지)&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="620" x="1000" y="700" as="geometry" />
        </mxCell>
        <mxCell id="u2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;몬스터 — 키는 스탯 SO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ MonsterWaveSpawner.GetOrCreatePool() — Dictionary&amp;lt;MonsterStatsSO, 풀&amp;gt;&lt;br&gt;Rent → PrepareForSpawn, 죽으면 UnSpawn → ReturnToPool (8페이지)&lt;br&gt;방 상태는 Dictionary&amp;lt;Guid, RoomWaveState&amp;gt;, 살아있는 몬스터는 List&amp;lt;Health&amp;gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="112" width="620" x="1000" y="830" as="geometry" />
        </mxCell>
        <mxCell id="eB1" edge="1" parent="1" source="zR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="zU" value="Rent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n0" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;풀을 쓰지 않는 곳: 무기 시각 오브젝트&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ NetworkWeaponEquip.ApplyMainHandVisual()&lt;br&gt;장착은 가끔 일어나는 동작이라 Destroy · ReleaseInstance를 쓴다. Addressable 인스턴스를 담는 풀이 아직 없다&lt;/span&gt;" vertex="1">
          <mxGeometry height="106" width="880" x="40" y="985" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Domain Reload를 꺼서 생기는 일&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;static은 세션을 넘어 남는다. ProjectilePool은 매 세션 새 레지스트리를 만든다&lt;/span&gt;" vertex="1">
          <mxGeometry height="106" width="340" x="940" y="985" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;네트워크 객체는 반납 순서가 있다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;UnSpawn이 먼저, 그다음 SetActive(false). 재사용하면 NetworkServer.Spawn을 다시 부른다&lt;/span&gt;" vertex="1">
          <mxGeometry height="106" width="340" x="1300" y="985" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="13. 빌드 · 배포 파이프라인" id="page9">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1493" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;" value="빌드 · 배포 파이프라인 — Addressables 번들 · Linux 서버 · Android 앱" vertex="1">
          <mxGeometry height="40" width="1500" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="lr_0" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" value="개발 PC에서 실행" vertex="1">
          <mxGeometry height="24" width="150" x="40" y="62" as="geometry" />
        </mxCell>
        <mxCell id="lr_1" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" value="EC2 서버에서 실행" vertex="1">
          <mxGeometry height="24" width="150" x="200" y="62" as="geometry" />
        </mxCell>
        <mxCell id="lr_2" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" value="플레이어 기기" vertex="1">
          <mxGeometry height="24" width="150" x="360" y="62" as="geometry" />
        </mxCell>
        
        <mxCell id="lr_4" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" value="설명 메모" vertex="1">
          <mxGeometry height="24" width="150" x="520" y="62" as="geometry" />
        </mxCell>
        <mxCell id="lr_note" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" value="▸ = 클래스.메서드. 화살표 글씨 = 전달하는 방법. 번호 ① ② ③ = 빌드 산출물" vertex="1">
          <mxGeometry height="28" width="790" x="850" y="60" as="geometry" />
        </mxCell>
        <mxCell id="hA" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="A. 어디서 무엇이 돌고, 무엇이 어디로 가나" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="98" as="geometry" />
        </mxCell>
        <mxCell id="zPC" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=28;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;개발 PC (Unity 에디터)&lt;/span&gt;" vertex="1">
          <mxGeometry height="400" width="520" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;① 번들 빌드&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ ServerBuildTool.BuildAddressablesRemote()&lt;br&gt;▸ ServerBuildTool.BuildAndDeployAndroidBundles()&lt;br&gt;ServerData/&amp;lt;타겟&amp;gt;/에 번들과 원격 카탈로그를 만든다&lt;/span&gt;" vertex="1">
          <mxGeometry height="112" width="480" x="60" y="190" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;② 헤드리스 Linux 서버 빌드&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ ServerBuildTool.BuildLinuxServer()&lt;br&gt;시작 씬 2개만 담는다. 번들은 안 굽고&lt;br&gt;①이 만든 로컬 카탈로그(aa)만 복사한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="112" width="480" x="60" y="318" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ Android APK 빌드&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ ServerBuildTool.BuildAndDeployAndroidAll()&lt;br&gt;번들(①)을 올린 뒤 APK. 설치는 기기에 직접&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="480" x="60" y="446" as="geometry" />
        </mxCell>
        <mxCell id="zEC" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fillOpacity=28;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;AWS EC2 (Linux)&lt;/span&gt;" vertex="1">
          <mxGeometry height="400" width="520" x="640" y="140" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;nginx가 8080 포트로 번들을 내준다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ nginx (listen 8080, root ServerData)&lt;br&gt;scp로 올라온 ServerData/&amp;lt;타겟&amp;gt;/을 정적 파일로 서빙&lt;br&gt;원격 주소: http://&amp;lt;EC2 IP&amp;gt;:8080/[BuildTarget]&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="480" x="660" y="190" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;systemd가 서버를 계속 살려 둔다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ systemd 서비스 mysecondworld&lt;br&gt;-batchmode -nographics. 죽으면 5초 뒤 다시 켠다&lt;br&gt;배포할 땐 멈추고 올린 뒤 다시 켠다 (실행 중인 파일은 덮어쓸 수 없다)&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="480" x="660" y="370" as="geometry" />
        </mxCell>
        <mxCell id="zDv" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E1D5E7;fillOpacity=28;strokeColor=#9673A6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;플레이어 기기&lt;/span&gt;" vertex="1">
          <mxGeometry height="400" width="400" x="1240" y="140" as="geometry" />
        </mxCell>
        <mxCell id="v1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;앱 (APK)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;시작 씬 2개만 들어 있다&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="360" x="1260" y="190" as="geometry" />
        </mxCell>
        <mxCell id="v2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;번들 동기화&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ ClientBundleSyncService&lt;br&gt;서버가 지시하면 라벨 단위로 받는다. 실패하면 2초 간격으로 3회 재시도한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="360" x="1260" y="290" as="geometry" />
        </mxCell>
        <mxCell id="v3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;서버에 접속&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;서버가 준비(ServerReady)된 뒤 스폰&lt;/span&gt;" vertex="1">
          <mxGeometry height="76" width="360" x="1260" y="450" as="geometry" />
        </mxCell>
        <mxCell id="eA1" edge="1" parent="1" source="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="e1" value="scp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eA2" edge="1" parent="1" source="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="e2" value="scp + ssh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eA3" edge="1" parent="1" source="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="v2" value="HTTP 다운로드">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eA4" edge="1" parent="1" source="v3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="e2" value="접속">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;개발 중에는 내 PC가 8080을 서빙한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;LocalBundleServerLauncher가 에디터를 열 때 ServerData를 python http.server 8080으로 서빙한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="790" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;로컬 카탈로그는 주소록, 원격 번들은 짐이다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;서버 빌드 안의 StreamingAssets/aa에는 &quot;어떤 에셋이 어디 있나&quot;만 있다. 없으면 서버가 시작 단계에서 멈춘다&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="790" x="850" y="560" as="geometry" />
        </mxCell>
        <mxCell id="hC" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="B. 원클릭 배포 — 메뉴 하나가 ①② 빌드를 하고, EC2에 올려 다시 켠다" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="660" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;1. 빌드: 번들 먼저, 서버 나중&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ BuildAllInternal()&lt;br&gt;① → ② 순서. 번들이 실패하면 서버는 굽지 않는다&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="252" x="40" y="705" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;2. 서버를 멈추고 폴더를 비운다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ RunSsh()&lt;br&gt;systemctl stop, rm -rf (-r 폴더째, -f 묻지 않고)&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="252" x="306" y="705" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;3. 번들을 올린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ RunScp()&lt;br&gt;ServerData/StandaloneLinux64 (①의 산출물)&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="252" x="572" y="705" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;4. 서버 파일을 올린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ RunScp()&lt;br&gt;Builds/Server (②의 산출물)&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="252" x="838" y="705" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;5. 권한을 주고 다시 켠다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ RunSsh()&lt;br&gt;chmod +x, systemctl restart&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="252" x="1104" y="705" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;6. 올라갔는지 확인한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ RunSsh()&lt;br&gt;ls로 aa와 번들, df -h로 용량&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="252" x="1370" y="705" as="geometry" />
        </mxCell>
        <mxCell id="ec1" edge="1" parent="1" source="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c2" value="">
