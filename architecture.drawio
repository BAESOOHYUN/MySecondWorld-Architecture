        <mxCell id="b10" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;② 12,000B씩 번호를 붙여 보낸다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ FileChunkSender.SendFileFromLocalstore()&lt;br&gt;청크 수만큼 CmdSendFileChunk를 반복&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="470" x="60" y="796" as="geometry" />
        </mxCell>
        <mxCell id="b11" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;② 캐시에 쌓고 바로 넘긴다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.CmdSendFileChunk()&lt;br&gt;받은 즉시 명단 전원에게 중계&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="470" x="605" y="796" as="geometry" />
        </mxCell>
        <mxCell id="b12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;② 번호 위치에 끼운다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.TargetRpcReceiveFileChunk()&lt;br&gt;(번호 × 12,000) 자리에 복사&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="470" x="1150" y="796" as="geometry" />
        </mxCell>
        <mxCell id="eb1a" edge="1" parent="1" source="b10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b11" value="[Command]">
