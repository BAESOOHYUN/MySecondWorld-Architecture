        <mxCell id="b00" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;① 파일을 고르고 크기를 알린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ FileChunkSender.SendFileFromLocalstore()&lt;br&gt;PDF · 이미지만 통과. 12,000B 단위로 자른다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="470" x="60" y="674" as="geometry" />
        </mxCell>
        <mxCell id="b01" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;① 발표자를 정하고 캐시를 만든다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.CmdSendFileStart()&lt;br&gt;다른 사람이 발표 중이면 거부&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="470" x="605" y="674" as="geometry" />
        </mxCell>
        <mxCell id="b02" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;① 받을 빈 버퍼를 만든다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.TargetRpcReceiveFileStart()&lt;br&gt;총 크기만큼 준비한다&lt;/span&gt;" vertex="1">
