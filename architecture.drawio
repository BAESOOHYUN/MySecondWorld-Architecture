        <mxCell id="eb1b" edge="1" parent="1" source="b11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b12" value="[TargetRpc]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b20" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ 총 크기를 알린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ FileChunkSender.SendFileFromLocalstore()&lt;br&gt;서버와 관객이 이 값으로 검증한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="470" x="60" y="918" as="geometry" />
        </mxCell>
        <mxCell id="b21" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ 캐시를 &quot;준비됨&quot;으로 바꾼다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.CmdSendFileEnd()&lt;br&gt;페이지 수를 세어 함께 보낸다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="470" x="605" y="918" as="geometry" />
        </mxCell>
        <mxCell id="b22" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ 검증이 맞아야 그린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.TargetRpcReceiveFileEnd()&lt;br&gt;크기와 청크 수가 맞을 때만 문서를 만든다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="470" x="1150" y="918" as="geometry" />
        </mxCell>
        <mxCell id="eb2a" edge="1" parent="1" source="b20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b21" value="[Command]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb2b" edge="1" parent="1" source="b21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b22" value="[TargetRpc]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nB1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;청크가 12,000B인 이유&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;65,536B로 보냈더니 PDF를 불러오는 순간 호스트가 크래시했다. 12,000B로 줄이고 ③의 검증을 보강했다 (9f09b705).&lt;/span&gt;" vertex="1">
          <mxGeometry height="83" width="790" x="40" y="1065" as="geometry" />
        </mxCell>
        <mxCell id="nB2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;발표자도 명단의 한 명이다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;서버는 명단(바깥 존 안의 사람)에게만 돌려준다. 발표자가 명단에 있어야 자기 화면도 받는다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="83" width="790" x="850" y="1065" as="geometry" />
        </mxCell>
        <mxCell id="hC" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="C. 늦게 온 사람 — 서버가 완성본을 들고 있다가, 존에 들어오면 그 사람에게만 다시 보낸다" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="1183" as="geometry" />
        </mxCell>
        <mxCell id="sC1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;① 바깥 존에 들어온다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenOuterZone&lt;br&gt;.OnTriggerEnter()&lt;br&gt;CmdEnterOuterZone()을 부른다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="370" x="40" y="1227" as="geometry" />
        </mxCell>
        <mxCell id="sC2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;② 명단에 올리고 캐시를 확인한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.CmdEnterOuterZone()&lt;br&gt;&quot;준비됨&quot;일 때만 보낸다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="370" x="450" y="1227" as="geometry" />
        </mxCell>
        <mxCell id="sC3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ 캐시를 그 한 명에게만 보낸다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.SendCachedFileToTarget()&lt;br&gt;B의 ① ② ③을 TargetRpc로 다시&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="370" x="860" y="1227" as="geometry" />
        </mxCell>
        <mxCell id="sC4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;④ 받고 &quot;보기&quot; 버튼만 켠다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.TargetRpcReceiveFileEnd()&lt;br&gt;화면은 원할 때 직접 연다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="370" x="1270" y="1231" as="geometry" />
        </mxCell>
        <mxCell id="eC1" edge="1" parent="1" source="sC1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="sC2" value="[Command]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eC2" edge="1" parent="1" source="sC2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="sC3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eC3" edge="1" parent="1" source="sC3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="sC4" value="[TargetRpc]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nC" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;왜 서버가 완성본을 들고 있나&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;처음에는 [ClientRpc]로 보내서 그 순간 접속해 있던 사람만 받았다. 서버가 캐시해 두었다가 존에 들어올 때 [TargetRpc]로 따로 보내도록 바꿨다 (c761d9b0).&lt;/span&gt;" vertex="1">
          <mxGeometry height="64" width="1600" x="40" y="1349" as="geometry" />
        </mxCell>
        <mxCell id="hD" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="D. 화면 동기화 — 발표자가 페이지 · 줌 · 스크롤을 바꾸면 관객이 따라간다" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="1448" as="geometry" />
        </mxCell>
        <mxCell id="sD1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;발표자가 넘기거나 확대한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenUI&lt;br&gt;.OnPdfViewerPageChanged() 외 2개&lt;br&gt;발표자일 때만 Command를 부른다&lt;/span&gt;" vertex="1">
          <mxGeometry height="121" width="370" x="40" y="1492" as="geometry" />
        </mxCell>
        <mxCell id="sD2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;서버가 발표자인지 검사한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.CmdChangePage() 외 2개&lt;br&gt;아니면 무시. 통과하면 SyncVar를 바꾼다&lt;/span&gt;" vertex="1">
          <mxGeometry height="121" width="370" x="450" y="1492" as="geometry" />
        </mxCell>
        <mxCell id="sD3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;화면이 곧바로 따라간다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.TargetRpcPageChanged() 외 2개&lt;br&gt;다시 그리거나 보는 영역만 바꾼다&lt;/span&gt;" vertex="1">
          <mxGeometry height="121" width="370" x="860" y="1492" as="geometry" />
        </mxCell>
        <mxCell id="sD4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;내 뷰어는 &quot;따라가기&quot;일 때만&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenUI&lt;br&gt;.OnPageChanged() 외 2개&lt;br&gt;발표자가 아니고 토글이 켜져 있을 때&lt;/span&gt;" vertex="1">
          <mxGeometry height="121" width="370" x="1270" y="1492" as="geometry" />
        </mxCell>
        <mxCell id="eD1" edge="1" parent="1" source="sD1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="sD2" value="[Command]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eD2" edge="1" parent="1" source="sD2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="sD3" value="[TargetRpc]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eD3" edge="1" parent="1" source="sD3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="sD4" value="구독 (R3)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nD0" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;에코를 끊는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;네트워크 값으로 뷰어를 바꾸면 뷰어 이벤트가 다시 터져 Command로 되돌아간다. _isSyncingFromNetwork가 true인 동안은 무시한다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="520" x="40" y="1633" as="geometry" />
        </mxCell>
        <mxCell id="nD1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;스크롤은 위치를 직접 놓는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;PDFViewer는 가로 이동 범위가 거의 0이라 normalizedPosition으로 X축을 못 맞춘다. ScrollRect를 잠깐 끄고 anchoredPosition을 직접 놓는다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="520" x="580" y="1633" as="geometry" />
        </mxCell>
        <mxCell id="nD2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;SyncVar가 지금 값의 기준이다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;뒤늦게 PDF를 열거나 따라가기를 켜면 현재 페이지 · 줌 · 영역을 읽어 한 번에 맞춘다. 스크롤은 마지막에 맞춘다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="520" x="1120" y="1633" as="geometry" />
        </mxCell>
        <mxCell id="hE" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="E. Quad 렌더링 — 해상도는 고정하고, 확대는 UV로 처리한다" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="1770" as="geometry" />
        </mxCell>
        <mxCell id="sE1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;한 페이지씩 1024px로 그린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController.RenderToScreen()&lt;br&gt;PDF 문서는 한 번만 만들어 캐시한다.&lt;br&gt;이전 텍스처는 Destroy한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="520" x="40" y="1814" as="geometry" />
        </mxCell>
        <mxCell id="sE2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Quad를 페이지 비율에 맞춘다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController.RenderToScreen()&lt;br&gt;가로 ÷ 세로로 scale을 정한다. 이미지는&lt;br&gt;LoadImage로 바로 텍스처가 된다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="520" x="580" y="1814" as="geometry" />
        </mxCell>
        <mxCell id="sE3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;확대 · 스크롤은 UV로 자른다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController.ApplyQuadZoom()&lt;br&gt;Material tiling · offset으로 보는 영역만 본다.&lt;br&gt;성능은 안정적이지만 확대하면 흐려진다&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="520" x="1120" y="1814" as="geometry" />
        </mxCell>
        <mxCell id="hF" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="F. 발표 끝내기 — 세 가지 이유로 끝나고, 서버가 상태를 되돌린다" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="1951" as="geometry" />
        </mxCell>
        <mxCell id="sF1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;&quot;발표 종료&quot; 버튼&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenUI&lt;br&gt;.OnEndPresent()&lt;/span&gt;" vertex="1">
          <mxGeometry height="83" width="270" x="40" y="1995" as="geometry" />
        </mxCell>
        <mxCell id="sF2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;발표자가 존을 떠난다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenOuterZone&lt;br&gt;.OnTriggerExit()&lt;/span&gt;" vertex="1">
          <mxGeometry height="83" width="270" x="330" y="1995" as="geometry" />
        </mxCell>
        <mxCell id="sF3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;발표자가 접속을 끊는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ NetworkServer&lt;br&gt;.OnDisconnectedEvent&lt;/span&gt;" vertex="1">
          <mxGeometry height="83" width="270" x="620" y="1995" as="geometry" />
        </mxCell>
        <mxCell id="sF4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;서버가 상태를 되돌린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.CmdReleasePresenter() · .CmdExitOuterZone() · .OnObserverDisconnected()&lt;br&gt;발표자 없음 · 페이지 0 · 줌 1 · 영역 전체로 SyncVar를 되돌리고 파일 캐시를 지운다&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="850" x="40" y="2138" as="geometry" />
        </mxCell>
        <mxCell id="sF5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;관객 화면을 비운다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenController : NetworkBehaviour&lt;br&gt;.TargetRpcClearScreen()&lt;br&gt;Quad 텍스처를 지우고 PDFDocument를 해제한다&lt;br&gt;▸ SharedScreenUI.OnPresenterChanged(0)&lt;br&gt;PDF 뷰어를 닫고 파일 불러오기 패널로 돌아간다&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="640" x="1000" y="2138" as="geometry" />
        </mxCell>
        <mxCell id="eF0" edge="1" parent="1" source="sF1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" target="sF4" value="[Command]">
