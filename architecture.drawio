        <mxCell id="c32" edge="1" parent="1" source="c28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c27" value="ISkill.Execute(SkillContext)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c33" edge="1" parent="1" source="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c24" value="실행 순서">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c34" edge="1" parent="1" source="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c25" value="실행 순서">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c35" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;피해를 받는 쪽&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ IDamageable · Health&lt;br&gt;CombatFaction: 아군오사 방지 · 어그로 조건&lt;br&gt;IStunnable: 피격 경직 · 기절 등 일시적 행동 제어&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="420" x="1200" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c36" edge="1" parent="1" source="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c35" value="피해 적용">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c37" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;규칙&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;호출하는 쪽은 ISkill만 안다. 어떤 에셋이 끼었는지는 모른다.&lt;br&gt;투사체는 도착해야 대상이 정해지므로 ①이 먼저다.&lt;br&gt;&lt;u&gt;슬롯의 SO는 전역 단일 인스턴스라 무상태여야 한다. 캐스터별 값은 SkillContext로 넘긴다.&lt;br&gt;&lt;/u&gt;몬스터는 AI가 ISkillSelector로 스킬 번호를 고르고 애니메이션을 재생하면, 타격 프레임의 애니메이션 이벤트로 Hitbox가 Execute를 부른다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="195" width="420" x="1200" y="535" as="geometry" />
        </mxCell>
        <mxCell id="c38" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;" value="B. 서버 권위 공격 — 클라가 보낸 값을 믿지 않는다" vertex="1">
          <mxGeometry height="31" width="900" x="40" y="917" as="geometry" />
        </mxCell>
        <mxCell id="c39" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;클라이언트가 입력과 연출을 맡는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ PlayerAttackController&lt;br&gt;입력 · 홀드 게이지 연출 · 애니메이션&lt;/span&gt;" vertex="1">
          <mxGeometry height="87" width="340" x="40" y="967" as="geometry" />
        </mxCell>
        <mxCell id="c40" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;서버가 요청을 받아 검증한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ PlayerAttackAuthority : NetworkBehaviour&lt;br&gt;CmdResolveAttackHit (근접)&lt;br&gt;CmdRequestShoot (원거리)&lt;br&gt;CmdBeginAim / CmdEndAim (조준)&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="420" x="620" y="967" as="geometry" />
        </mxCell>
        <mxCell id="c41" edge="1" parent="1" source="c39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" target="c40" value="[Command] 요청 (클라 → 서버)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c42" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" value="서버가 직접 정하거나 검증하는 값" vertex="1">
          <mxGeometry height="24" width="700" x="40" y="1114" as="geometry" />
        </mxCell>
        <mxCell id="c43" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;공격력은 서버가 직접 조회한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;장착 무기에서 읽는다. 클라가 보낸 값은 무시&lt;br&gt;▸ GetMainHandAttack()&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="300" x="40" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="c44" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;충돌 마스크는 서버 상수로 고정한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;클라 입력을 아예 받지 않는다&lt;br&gt;▸ MonsterLayerMask&lt;/span&gt;" vertex="1">
          <mxGeometry height="108" width="300" x="360" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="c45" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;공격 위치는 내 캐릭터와의 거리로 검증한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;4m를 넘으면 무시&lt;br&gt;▸ MaxAttackReach&lt;/span&gt;" vertex="1">
          <mxGeometry height="108" width="300" x="680" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="c46" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;쿨다운은 서버 시계로 따로 잰다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;클라보다 10% 느슨하게 (정상 플레이가 막히지 않게)&lt;br&gt;▸ _serverNextShootTime&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="300" x="1000" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="c47" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;조준 게이지는 서버가 직접 측정한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;홀드 시간 · 이동 여부를 서버가 본다&lt;br&gt;▸ _aimGaugeServer&lt;/span&gt;" vertex="1">
          <mxGeometry height="108" width="300" x="1320" y="1122" as="geometry" />
        </mxCell>
        <mxCell id="c48" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;" value="C. 근접 공격 파이프라인 — 클라가 &quot;쳤다&quot;고 알리면, 서버가 범위를 직접 훑어 판정한다" vertex="1">
          <mxGeometry height="31" width="1500" x="40" y="1318" as="geometry" />
        </mxCell>
        <mxCell id="c49" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;클라이언트가 타격 순간을 알린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ PlayerAttackController&lt;br&gt;   .OnAttackHit()&lt;br&gt;공격 애니메이션의 타격 프레임에 애니메이션 이벤트로 호출&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="340" x="60" y="1418" as="geometry" />
        </mxCell>
        <mxCell id="c51" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;서버가 요청을 검증한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ PlayerAttackAuthority&lt;br&gt;   .CmdResolveAttackHit()&lt;br&gt;[Command]로 받는다. 위치는 4m 이내인지 검증하고, 공격력은 서버가 직접 조회한다&lt;br&gt;클라가 노린 대상(netId)은 공격 범위(구) 안에 있을 때만 우선 적용&lt;/span&gt;" vertex="1">
          <mxGeometry height="177" width="280" x="60" y="1693" as="geometry" />
        </mxCell>
        <mxCell id="c52" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;공격 범위 안의 대상 후보를 모은다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ SphereAttackResolver&lt;br&gt;   .ResolveAndExecute()&lt;br&gt;OverlapSphere로 범위 안의 후보를 찾아 SkillContext를 만든다&lt;/span&gt;" vertex="1">
          <mxGeometry height="144" width="280" x="380" y="1693" as="geometry" />
        </mxCell>
        <mxCell id="c53" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;스킬을 실행한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ SkillDefinition : ISkill&lt;br&gt;   .Execute()&lt;br&gt;_meleeSkill 실행 (축 구성은 스킬 에셋에 따름)&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="280" x="700" y="1693" as="geometry" />
        </mxCell>
        <mxCell id="c54" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;피해를 적용한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ IDamageable (Health)&lt;/span&gt;" vertex="1">
          <mxGeometry height="69" width="280" x="1020" y="1693" as="geometry" />
        </mxCell>
        <mxCell id="c55" edge="1" parent="1" source="c51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" target="c52" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c56" edge="1" parent="1" source="c52" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" target="c53" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c59" edge="1" parent="1" source="c49" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" target="c51" value="[Command]&lt;br&gt;CmdResolveAttackHit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c60" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;OverlapSphere란&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Unity 물리 함수 Physics.OverlapSphere.&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size:13px&quot;&gt;중심점과 반경을 주면 그 점을 중심으로 한 공 모양(구) 범위를 만들고, 그 안에 닿아 있는 콜라이더를 한꺼번에 모아 준다.&lt;br&gt;근접 공격의 &quot;타격 범위&quot;를 이렇게 판정한다. 총알처럼 날아가는 게 아니라, 타격 순간에 그 범위 안에 누가 있는지 한 번 확인하는 방식이다. 지정한 레이어만 보고, 트리거 콜라이더는 무시한다.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="123" width="790" x="40" y="1920" as="geometry" />
        </mxCell>
        <mxCell id="c61" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;SphereAttackResolver는 공용 부품&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;플레이어(PlayerAttackAuthority) · 몬스터(MonsterHitbox) · 컴패니언(CompanionHitbox) · 보스 범위 공격(BossAoEHitbox)이 모두 같은 클래스로 판정한다. 범위 판정과 SkillContext 구성이 한 곳에 있다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="87" width="790" x="870" y="1920" as="geometry" />
        </mxCell>
        <mxCell id="c62" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;" value="D. 원거리 투사체 파이프라인 — 서버가 판정하고, 클라는 보여 주기만 한다" vertex="1">
          <mxGeometry height="31" width="1500" x="40" y="2103" as="geometry" />
        </mxCell>
        <mxCell id="oZZz5EeGvl7pkcpr7dak-1" edge="1" parent="1" source="c53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="c54" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="1599" as="sourcePoint" />
            <mxPoint x="710" y="1590" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="stateless-note-1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;슬롯 SO가 무상태가 아니면 생기는 일&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;SO 에셋은 게임 전체에 하나뿐이라, 같은 스킬을 쓰는 몬스터 · 플레이어가 모두 같은 객체를 공유한다.&lt;br&gt;여기에 &quot;지금 노리는 대상&quot;, &quot;마지막 명중 위치&quot; 같은 값을 저장하면 다른 시전자가 같은 칸을 덮어써서, 엉뚱한 대상에게 피해가 가거나 폭발 위치가 어긋난다.&lt;br&gt;투사체는 도착을 기다리는(await) 동안 다른 시전자나 같은 시전자의 다음 발이 값을 덮어쓸 수 있어서, 연사도 안 된다.&lt;br&gt;그래서 &lt;u&gt;값은 시전마다 새로 만드는 SkillContext에 담는다.&lt;/u&gt; 예: 폭발 중심은 ctx.SetEpicenter(...)로 전달한다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="213" width="420" x="1200" y="750" as="geometry" />
        </mxCell>
        <mxCell id="rcArosuYG4XdXFg1hASv-1" edge="1" parent="1" source="c52" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;rounded=0;defaultLabelBackgroundColor=page;entryX=0.25;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="c61" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="880" y="1930" as="sourcePoint" />
            <mxPoint x="930" y="1880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rcArosuYG4XdXFg1hASv-3" edge="1" parent="1" source="c60" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;rounded=0;defaultLabelBackgroundColor=page;entryX=0.526;entryY=0.99;entryDx=0;entryDy=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryPerimeter=0;" target="c52" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="600" y="1700" as="sourcePoint" />
            <mxPoint x="532.5000000000005" y="1589.0000000000005" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dd34" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=35;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=16;" value="클라이언트 (표현)" vertex="1">
          <mxGeometry height="310" width="1620" x="40" y="3158" as="geometry" />
        </mxCell>
        <mxCell id="dd21" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fillOpacity=35;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=16;" value="서버 (판정 권위)" vertex="1">
          <mxGeometry height="662" width="1620" x="40" y="2426" as="geometry" />
        </mxCell>
        <mxCell id="dd11" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=35;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=16;" value="클라이언트 (입력)" vertex="1">
          <mxGeometry height="203" width="1620" x="40" y="2153" as="geometry" />
        </mxCell>
        <mxCell id="dd10" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;클라이언트가 조준하고 발사를 요청한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ PlayerAttackController&lt;br&gt;홀드 시작: CmdBeginAim()으로 서버에 조준 시작을 알린다 (게이지는 서버가 직접 잰다)&lt;br&gt;발사 프레임(ReleaseArrow): ① CmdRequestShoot(origin, direction) 호출  ② 순수 클라이언트면 손에 든 화살로 표현 화살을 직접 띄운다&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="760" x="60" y="2209" as="geometry" />
        </mxCell>
        <mxCell id="dd12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;화살을 풀에서 빌려 준다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ ProjectilePool&lt;br&gt;   .Rent()&lt;br&gt;(프리팹 × 씬) 단위 풀. 씬이 내려가면 그 풀도 함께 정리&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="280" x="1020" y="2482" as="geometry" />
        </mxCell>
        <mxCell id="dd13" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;명중 지점을 클라이언트에 알린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ NetworkProjectileRelay : NetworkBehaviour&lt;br&gt;   .RpcConfirmHit()&lt;br&gt;호출은 ProjectileRequest의 OnResolved 콜백에 꽂혀 있다 (Projectile은 네트워크를 모른다)&lt;/span&gt;" vertex="1">
          <mxGeometry height="159" width="280" x="1340" y="2482" as="geometry" />
        </mxCell>
        <mxCell id="dd14" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;서버가 요청을 검증하고 발사 정보를 만든다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ PlayerAttackAuthority&lt;br&gt;   .CmdRequestShoot()&lt;br&gt;요청을 검증하고 ProjectileRequest를 만든다&lt;/span&gt;" vertex="1">
          <mxGeometry height="144" width="280" x="60" y="2676" as="geometry" />
        </mxCell>
        <mxCell id="dd15" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;발사에 필요한 값을 한 묶음으로 담는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ ProjectileRequest (struct)&lt;br&gt;원점 · 방향 · 속도 · 충돌 반경 · 마스크 · 유도 대상 · OnResolved 콜백. 함수(동작)는 없다&lt;/span&gt;" vertex="1">
          <mxGeometry height="144" width="280" x="380" y="2676" as="geometry" />
        </mxCell>
        <mxCell id="dd16" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;스킬 실행을 시작하고 화살이 도착할 때까지 기다린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ SkillDefinition : ISkill&lt;br&gt;   .Execute()&lt;br&gt;① 축2 ProjectileCastSO가 발사를 시작하고, 도착(명중 · 소멸)까지 await로 기다린다&lt;/span&gt;" vertex="1">
          <mxGeometry height="162" width="280" x="700" y="2676" as="geometry" />
        </mxCell>
        <mxCell id="dd17" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;화살을 확보해 날려 보낸다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ ProjectileLauncher&lt;br&gt;   .Launch()&lt;br&gt;손 화살이 있으면 그것을, 없으면 풀에서 대여. 서버면 판정 모드(Authoritative)로 발사&lt;/span&gt;" vertex="1">
          <mxGeometry height="141" width="280" x="1020" y="2717" as="geometry" />
        </mxCell>
        <mxCell id="dd18" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;화살이 날아가며 충돌을 판정한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ Projectile (서버)&lt;br&gt;Update마다 이번 이동 구간을 SphereCast로 훑는다. 명중 · 벽 · 수명 초과면 Resolve()로 끝내고 풀에 반납&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="280" x="1340" y="2701" as="geometry" />
        </mxCell>
