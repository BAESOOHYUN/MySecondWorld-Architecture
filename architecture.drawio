        </mxCell>
        <mxCell id="hA" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="A. 구성 — 바깥 존 ⊃ 안쪽 존 ⊃ 화면. 안으로 들어갈수록 더 많은 것이 보인다" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="98" as="geometry" />
        </mxCell>
        <mxCell id="zO" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=28;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;바깥 존 — 들어오면 받을 사람 명단에 오른다&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;▸ SharedScreenOuterZone · .OnTriggerEnter() → CmdEnterOuterZone() · .OnTriggerExit() → CmdExitOuterZone()&lt;/span&gt;" vertex="1">
          <mxGeometry height="330" width="1600" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="zI" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=28;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;안쪽 존 — 들어오면 조작 화면(UI)이 열린다&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;▸ SharedScreenInteraction · .OnTriggerEnter() → UI를 만들거나 재사용 · .OnTriggerExit() → UI를 숨긴다&lt;/span&gt;" vertex="1">
          <mxGeometry height="240" width="1556" x="62" y="214" as="geometry" />
        </mxCell>
        <mxCell id="zS" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E1D5E7;fillOpacity=28;strokeColor=#9673A6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;화면(Quad)&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="800" x="82" y="284" as="geometry" />
        </mxCell>
        <mxCell id="aR" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;파일을 그림으로 바꾼다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ SharedScreenRenderer.Render()&lt;br&gt;byte[] · PDFDocument → Texture2D&lt;/span&gt;" vertex="1">
