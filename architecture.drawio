        </mxCell>
        <mxCell id="ef5" edge="1" parent="1" source="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" target="c3" value="줌">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFE6CC;fillOpacity=28;strokeColor=#D79B00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;월드&lt;/span&gt;" vertex="1">
          <mxGeometry height="190" width="1600" x="40" y="793" as="geometry" />
        </mxCell>
        <mxCell id="w2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;탭에 반응하는 대상&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ ITapTargetable&lt;br&gt;NPCInteractable · MonsterTapTarget&lt;br&gt;구독: PlayerTapAttack · MonsterTargetUI&lt;/span&gt;" vertex="1">
          <mxGeometry height="134" width="280" x="420" y="835" as="geometry" />
        </mxCell>
        <mxCell id="w3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;탭으로 대상을 고른다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ TapTargetResolver.HandleTap()&lt;br&gt;TapTarget 레이어만 광선을 쏜다&lt;br&gt;한 번에 승자는 한 명&lt;/span&gt;" vertex="1">
          <mxGeometry height="134" width="340" x="780" y="835" as="geometry" />
        </mxCell>
        <mxCell id="w4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;카메라가 보는 방향으로 걷는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ MovementController.JoyStickMove()&lt;br&gt;조이스틱 입력을 자기 축(IInputAxisOwner)으로 직접 받는다&lt;br&gt;카메라의 Y 회전만 뽑아 방향을 만든다 (Func&amp;lt;float&amp;gt; GetCameraYAngle로 각도만 받는다)&lt;/span&gt;" vertex="1">
          <mxGeometry height="134" width="480" x="1140" y="835" as="geometry" />
        </mxCell>
        <mxCell id="ef6" edge="1" parent="1" source="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c4" value="탭">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef6b" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="w3" value="광선">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef7" edge="1" parent="1" source="w3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="w2" value="OnTapped()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef8" edge="1" parent="1" source="w2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="c2" value="NPC면 FocusOnNPC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef9" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="w4" value="GetCameraYAngle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hS" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" value="입력 흐름과는 별개인 클라이언트의 일" vertex="1">
          <mxGeometry height="28" width="1500" x="40" y="1001" as="geometry" />
        </mxCell>
        <mxCell id="sd" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;씬이 바뀌어도 오브젝트가 사라지지 않게 한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ ClientSceneSyncService&lt;br&gt;Mirror의 클라이언트 스폰은 그 순간의 활성 씬에 생겨서, 씬이 내려가면 같이 사라진다. 서버는 스폰을 다시 보내 주지 않는다.&lt;br&gt;그래서 목적지 씬이 정해지면 한곳으로 모으고, 언로드 직전에는 MainScene으로 대피시킨다&lt;/span&gt;" vertex="1">
          <mxGeometry height="96" width="1600" x="40" y="1033" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;서버에는 입력 계층이 없다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;TouchEventListener는 서버 빌드에 등록되지 않는다. 그래서 카메라 컨트롤러는 이것을 선택 주입(null 허용)으로 받는다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="83" width="790" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;탭 판정은 보이는 크기가 아니라 콜라이더로 한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;렌더러 바운드는 몸보다 커서 컴패니언이 옆 NPC의 클릭을 가로챘다. 그래서 몸통 콜라이더 치수의 TapTarget 트리거를 광선으로 맞힌다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="83" width="790" x="850" y="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
