        <mxCell id="lr_note" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" value="▸ = 클래스.메서드 또는 설정 에셋. 렌더링 항목은 커밋 7555b22e · 2c677d24 · 45153d29로 확인한 설정이다" vertex="1">
          <mxGeometry height="28" width="419" x="1221" y="60" as="geometry" />
        </mxCell>
        <mxCell id="hA" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="A. 렌더링 — 폴리곤이 아니라 드로우콜이 병목이었다" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="98" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;① 병목 측정 — 무엇이 느린지 먼저 쟀다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;PolygonFantasyKingdom 데모 씬&lt;br&gt;Batches 33,182 = 드로우콜&lt;br&gt;Static · Dynamic · Instancing&lt;br&gt;배칭이 모두 0건&lt;br&gt;&lt;br&gt;→ 폴리곤을 줄이는 LOD가 아니라&lt;br&gt;드로우콜을 줄이는 것이 답&lt;/span&gt;" vertex="1">
          <mxGeometry height="260" width="340" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="zG" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=28;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;② GPU Resident Drawer — 드로우콜을 GPU에서 묶는다&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;▸ URP-HighFidelity.asset&lt;/span&gt;" vertex="1">
          <mxGeometry height="260" width="750" x="430" y="140" as="geometry" />
        </mxCell>
        <mxCell id="g0" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Instanced Drawing 켬 — 메시를 합치지 않고 오브젝트별 컬링은 유지한 채 묶는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="710" x="450" y="196" as="geometry" />
        </mxCell>
        <mxCell id="gT" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" value="켜기 위한 조건 셋 — 켜면 Unity가 경고로 알려 준다" vertex="1">
          <mxGeometry height="22" width="710" x="450" y="252" as="geometry" />
        </mxCell>
        <mxCell id="g1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Forward+ 렌더 경로&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;라이트를 화면 구역별로 처리하는 방식. GPU Resident Drawer가 요구한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="112" width="230" x="450" y="278" as="geometry" />
        </mxCell>
        <mxCell id="g2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;셰이더 변형 Keep All&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;BatchRendererGroup용 셰이더 변형이 빌드에서 제거되지 않게 한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="112" width="230" x="695" y="278" as="geometry" />
        </mxCell>
        <mxCell id="g3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Static Batching 끔&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;메시를 미리 합치는 방식이라 GPU Resident Drawer와 충돌한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="112" width="220" x="940" y="278" as="geometry" />
        </mxCell>
        <mxCell id="zB" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=28;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;③ 모바일(Balanced) 티어를 따로 조인다&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;▸ URP-Balanced.asset (Android · iOS가 쓰는 티어)&lt;/span&gt;" vertex="1">
          <mxGeometry height="260" width="420" x="1220" y="140" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Soft Shadows · LOD Cross Fade 끔&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;그림자 흐림과 LOD 전환 블렌딩을 없앤다&lt;/span&gt;" vertex="1">
          <mxGeometry height="62" width="380" x="1240" y="204" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;GPU Occlusion Culling 켬&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;가려진 오브젝트를 GPU에서 걸러낸다&lt;/span&gt;" vertex="1">
