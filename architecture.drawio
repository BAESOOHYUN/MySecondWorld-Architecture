        <mxCell id="c12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;플레이어가 스킬을 쓴다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ PlayerAttackAuthority (서버)&lt;br&gt;스킬: _meleeSkill · _rangedSkill&lt;/span&gt;" vertex="1">
          <mxGeometry height="87" width="330" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;몬스터 · 보스가 스킬을 쓴다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ MonsterHitbox · RangedMonsterHitbox&lt;br&gt;▸ BossAoEHitbox&lt;br&gt;스킬: 스탯 SO의 AttackSkill · AoESkill&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="330" x="415" y="120" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;컴패니언이 스킬을 쓴다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ CompanionHitbox&lt;br&gt;스킬: 스탯 SO의 AttackSkill&lt;/span&gt;" vertex="1">
          <mxGeometry height="87" width="330" x="780" y="120" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;바로 발동한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ InstantCast&lt;/span&gt;" vertex="1">
          <mxGeometry height="69" width="260" x="80" y="426" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;투사체가 도착하면 발동한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ ProjectileCast&lt;/span&gt;" vertex="1">
