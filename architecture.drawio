        <mxCell id="c36" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Microsoft Edge TTS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;NativeWebSocket → MP3 → AudioClip&lt;/span&gt;" vertex="1">
