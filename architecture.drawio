        <mxCell id="eP2" edge="1" parent="1" source="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="p3" value="죽는다">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eP3" edge="1" parent="1" source="p3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="p1" value="OnReturnedToPool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zW" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fillOpacity=28;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;스포너 — MonsterWaveSpawner (방마다 웨이브 상태를 따로 든다)&lt;/span&gt;" vertex="1">
          <mxGeometry height="310" width="860" x="780" y="1245" as="geometry" />
        </mxCell>
        <mxCell id="w0" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;방이 열리고 닫힐 때 스포너를 부른다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ GameNetworkManager.HandleRoomOpened() → IRoomWaveSpawner.StartWaves(matchId)&lt;br&gt;방이 닫히면 StopWaves가 그 방 몬스터를 죽음 연출 없이 풀에 반납&lt;/span&gt;" vertex="1">
          <mxGeometry height="76" width="820" x="800" y="1291" as="geometry" />
        </mxCell>
        <mxCell id="w1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;던전 방 A (matchId A)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;웨이브를 전멸시키면&lt;br&gt;대기 후 다음 웨이브.&lt;br&gt;끝나면 OnAllWavesCleared&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="800" y="1405" as="geometry" />
        </mxCell>
        <mxCell id="w2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;던전 방 B (matchId B)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;같은 던전 씬 · 같은 좌표에&lt;br&gt;겹쳐 있어도 방마다&lt;br&gt;몬스터 세트가 따로다&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="1080" y="1405" as="geometry" />
        </mxCell>
        <mxCell id="w3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;필드 (방 하나)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;matchId = 씬 경로 해시.&lt;br&gt;죽으면 N초 뒤 같은 지점&lt;br&gt;반경에 다시 스폰한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="1360" y="1405" as="geometry" />
        </mxCell>
        <mxCell id="eW0" edge="1" parent="1" source="w0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.16;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="w1" value="">
