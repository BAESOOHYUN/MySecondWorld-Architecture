        </mxCell>
        <mxCell id="hA" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="A. 구성 — 캐릭터 안의 컴포넌트가 연결 상자를 거쳐 UI와 이어진다" vertex="1">
          <mxGeometry height="31" width="1560" x="40" y="98" as="geometry" />
        </mxCell>
        <mxCell id="zP" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fillOpacity=28;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;플레이어 캐릭터 프리팹 — 한 GameObject에 모여 있다&lt;/span&gt;" vertex="1">
          <mxGeometry height="310" width="760" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Inventory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ Cleverous.VaultInventory.Inventory&lt;br&gt;슬롯의 주인. 넣고 빼는 호출은&lt;br&gt;서버 Command 안에서만 있다.&lt;br&gt;서버는 OnStartServer, 클라이언트는&lt;br&gt;OnStartClient에서 한 번 Initialize한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="246" width="330" x="60" y="190" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;NetworkCharacterAppearance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;파츠 외형 (SyncVar)&lt;/span&gt;" vertex="1">
