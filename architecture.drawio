        <mxCell id="eF2" edge="1" parent="1" source="sF3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" target="sF4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eF4" edge="1" parent="1" source="sF4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="sF5" value="[TargetRpc]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nF" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;발표자가 있는 동안&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;새 파일 열기 · 페이지 · 줌 · 스크롤 Command는 발표자만 통과한다. 발표자가 없으면 파일을 먼저 여는 사람이 발표자가 된다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="64" width="1600" x="40" y="2303" as="geometry" />
