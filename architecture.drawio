            <mxPoint x="830" y="690" as="sourcePoint" />
            <mxPoint x="880" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mic_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" value="공유 대화창 · 마이크 — NPC가 여러 명이어도 하나만 두고, 서로 부딪히지 않게 지킨다" vertex="1">
          <mxGeometry height="36" width="1000" x="40" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="mic_grp" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=35;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=16;" value="구조 — NPCLifetimeScope (MainScene): 모든 NPC의 부모 스코프에 하나만 둔다" vertex="1">
          <mxGeometry height="420" width="1620" x="40" y="1560" as="geometry" />
