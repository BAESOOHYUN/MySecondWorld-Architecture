        <mxCell id="hB" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="B. 몬스터의 생애 — 상태 머신 (MonsterAI)" vertex="1">
