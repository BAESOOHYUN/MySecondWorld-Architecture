          <mxGeometry height="134" width="470" x="605" y="676" as="geometry" />
        </mxCell>
        <mxCell id="w3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;무기 · 모두가 같은 무기를 든다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ NetworkWeaponEquip.OnMainHandChanged()&lt;br&gt;카테고리에 맞는 소켓에 붙이고 Animator&lt;br&gt;컨트롤러를 바꾼다 (활은 등에 화살통도)&lt;/span&gt;" vertex="1">
          <mxGeometry height="134" width="470" x="1150" y="676" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;파츠 · 번호를 찾아 외형 데이터를 고친다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ CharacterAppearanceService.EquipWearableItem()&lt;br&gt;아이템 → (파츠, 번호)를 거꾸로 찾고, 좌우 쌍은&lt;br&gt;같이 맞춘다. 로컬 저장 뒤 내 화면에 먼저 적용&lt;/span&gt;" vertex="1">
          <mxGeometry height="134" width="470" x="60" y="836" as="geometry" />
