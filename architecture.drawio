        <mxCell id="c30" edge="1" parent="1" source="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="c21" value="답변">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c31" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;2. 메시지를 입력한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ NPCDialogueUI : MonoBehaviour, INPCDialogueUI&lt;br&gt;   .OnSubmit&lt;br&gt;텍스트 입력, 또는 마이크 버튼을 누르는 동안 음성 입력&lt;br&gt;보내기 · 닫기 버튼은 NPCInteractable이 받는다&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="460" x="40" y="771" as="geometry" />
        </mxCell>
        <mxCell id="c32" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;말을 글자로 바꿔 입력창에 넣는다 (음성 입력)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ ISTTService (공유 스코프)&lt;br&gt;마이크가 기기당 1개라 여러 NPC가 공유한다 (아래 도식)&lt;br&gt;마이크 녹음 → WAV → 텍스트&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="460" x="40" y="966" as="geometry" />
        </mxCell>
        <mxCell id="c33" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;클라우드 모드 (Groq)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ GroqWhisperSTTService&lt;br&gt;Groq Whisper (whisper-large-v3-turbo)에 HTTPS로 전송&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="225" x="40" y="1141" as="geometry" />
        </mxCell>
        <mxCell id="c34" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;로컬 모드&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ WhisperSTTService&lt;br&gt;whisper.unity로 기기 안에서 인식&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="225" x="275" y="1141" as="geometry" />
        </mxCell>
        <mxCell id="c35" edge="1" parent="1" source="c32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c33" value="UseServerMode = true">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c36" edge="1" parent="1" source="c32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c34" value="= false">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c37" edge="1" parent="1" source="c32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="c31" value="인식 결과를 입력창에">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c38" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;3. 메시지를 해당 NPC에게만 전달한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ MessagePipe 이벤트 버스&lt;br&gt;PlayerMessageSentEvent (키 = NPC GUID + 인스턴스 ID → NPC 개체마다 독립 채널)&lt;br&gt;그 밖의 이벤트: NPCThinkingStartedEvent · NPCResponseReceivedEvent · NPCTTSSentenceEvent · NPCStopTTSEvent · NPCSpeakFinishedEvent · NPCSentenceStartedEvent · NPCDialogueEvent&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="480" x="620" y="160" as="geometry" />
        </mxCell>
        <mxCell id="c39" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;성격 · 말투&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ NPCSystemPromptSO&lt;br&gt;NPC 이름과 시스템 프롬프트&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="145" x="630" y="389" as="geometry" />
        </mxCell>
        <mxCell id="c40" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;기억&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ NPCMemorySO&lt;br&gt;지난 대화 + 알고 있는 사실&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="145" x="785" y="389" as="geometry" />
        </mxCell>
        <mxCell id="c41" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;서버가 아는 상황&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ NPCServerState&lt;br&gt;퀘스트 단계 · 진영 관계&lt;/span&gt;" vertex="1">
          <mxGeometry height="126" width="145" x="940" y="389" as="geometry" />
        </mxCell>
        <mxCell id="c42" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;4. 재료를 모아 프롬프트를 만들고 LLM에 묻는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ NPCBrain&lt;br&gt;프롬프트는 ZString으로 조립&lt;br&gt;지금 대화 중인 내 NPC에게 온 메시지에만 반응&lt;br&gt;답변마다, 그리고 대화창을 닫을 때 새로 알게 된 사실을 뽑아 기억에 저장 (ExtractFactAsync)&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="460" x="630" y="575" as="geometry" />
        </mxCell>
        <mxCell id="c44" edge="1" parent="1" source="c39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.17;entryY=0;entryDx=0;entryDy=0;" target="c42" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c45" edge="1" parent="1" source="c40" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c42" value="읽기 · 새 사실 저장">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c46" edge="1" parent="1" source="c41" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.83;entryY=0;entryDx=0;entryDy=0;" target="c42" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c47" edge="1" parent="1" source="c38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 3;strokeColor=#9673A6;fontColor=#6C3F8F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c43" value="해당 NPC만 받는다 (Subscribe)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c48" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;5. 답변을 만든다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ ILLMService&lt;br&gt;UseServerMode에 따라 구현이 바뀐다&lt;br&gt;만들어지는 글을 onToken 콜백으로 NPCBrain(6번)에 돌려준다&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="440" x="1320" y="160" as="geometry" />
        </mxCell>
        <mxCell id="c50" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;클라우드 모드 (Groq)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ GroqLLMService&lt;br&gt;qwen/qwen3.8-27b&lt;br&gt;전체 답변을 한 번에 받고, 문장 끝마다 onToken 호출 (SimulateStreaming — 진짜 스트리밍은 아님)&lt;br&gt;429(요청 한도 초과)면 1 · 2 · 4초 대기 후 재시도 (최대 3회)&lt;/span&gt;" vertex="1">
          <mxGeometry height="200" width="215" x="1320" y="335" as="geometry" />
        </mxCell>
        <mxCell id="c51" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;로컬 모드&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ LocalLLMService&lt;br&gt;LLMUnity(llama.cpp)로 기기 안에서 추론&lt;br&gt;Gemma 3 4B (RAM 6GB 이상) · 1B (3.5~6GB)&lt;br&gt;토큰이 나올 때마다 onToken 호출 (진짜 스트리밍)&lt;/span&gt;" vertex="1">
          <mxGeometry height="200" width="215" x="1545" y="335" as="geometry" />
        </mxCell>
        <mxCell id="c54" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;7. 변환을 맡기고, 소리를 끊김 없이 이어서 재생한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ NPCVoicePlayer&lt;br&gt;문장이 도착하는 즉시 8번에 변환을 맡기고 큐에 넣는다&lt;br&gt;변환이 끝난 소리부터 AudioSource 2개를 번갈아 써서 문장 사이 끊김 없이 이어 재생한다&lt;br&gt;재생을 예약하면 NPCSentenceStartedEvent, 모두 끝나면 NPCSpeakFinishedEvent를 발행한다&lt;br&gt;NPCStopTTSEvent가 오면 큐를 비우고 정지한다&lt;/span&gt;" vertex="1">
          <mxGeometry height="245" width="440" x="1320" y="845" as="geometry" />
        </mxCell>
        <mxCell id="c55" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;8. 문장 하나를 소리 파일로 바꾼다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ ITTSService&lt;br&gt;구현: EdgeTTSServiceNativeWebSocket (고정)&lt;br&gt;MS Edge TTS에 WebSocket으로 요청 → MP3 → AudioClip&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="440" x="1320" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="c56" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;10. 소리 크기에 맞춰 입을 움직인다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ NPCLipSyncController&lt;br&gt;NPCVoicePlayer의 재생 시작 · 끝 신호로 켜고 끈다&lt;br&gt;AudioSource 출력 파형(256샘플)의 평균 진폭을 잰다&lt;br&gt;입 모양 머티리얼 4단계(neutral · small · mid · open)로 교체. 음소 분석은 하지 않는다&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="620" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="c57" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;언제 클라우드 / 로컬을 고르나&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;IDeviceCapability.UseServerMode 하나로 LLM · STT를 교체한다 (true = 클라우드 Groq, false = 로컬).&lt;br&gt;TTS는 Azure가 한국어 감정을 지원하지 않아 Edge로 고정 (코드 주석 기준).&lt;/span&gt;" vertex="1">
          <mxGeometry height="123" width="440" x="1320" y="1335" as="geometry" />
        </mxCell>
        <mxCell id="c58" edge="1" parent="1" source="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 3;strokeColor=#9673A6;fontColor=#6C3F8F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" target="c38" value="2 → 3&lt;br&gt;(Publish)">
          <mxGeometry relative="1" x="0.4067" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="112.5" y="589" />
              <mxPoint x="550" y="589" />
              <mxPoint x="550" y="258.4" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4_submit" edge="1" parent="1" source="c31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" target="c24" value="보내기 · 닫기&lt;br&gt;(OnSubmit · OnClose)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4_open" edge="1" parent="1" source="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" target="c31" value="열기 · 입력 잠금&lt;br&gt;(Open · ShowThinking)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4_resp" edge="1" parent="1" source="c42" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 3;strokeColor=#9673A6;fontColor=#6C3F8F;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" target="c24" value="답변 도착&lt;br&gt;(NPCResponse&lt;br&gt;ReceivedEvent)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;9. 재생이 시작되면 문장을 화면에 보여 준다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ NPCDialogueUI : MonoBehaviour, INPCDialogueUI&lt;br&gt;   .AppendSentence()&lt;br&gt;문장이 읽히기 시작할 때(NPCSentenceStartedEvent) 한 문장씩 표시&lt;br&gt;음성이 끝나면(NPCSpeakFinishedEvent) 입력창을 다시 연다&lt;br&gt;생각 중(NPCThinkingStartedEvent)에는 &quot;생각 중&quot;을 보이고 입력을 잠근다&lt;br&gt;답변 전체가 도착하면(NPCResponseReceivedEvent) NPC 이름과 기억 · 대화 기록 탭을 새로 그린다&lt;br&gt;응답이 비어 있으면 &quot;잘 듣지 못했어요&quot; 문구를 띄우고 입력창을 연다&lt;br&gt;음성 문장이 2초 안에 한 번도 안 오면 답변 전체를 바로 표시한다 (안전망)&lt;br&gt;닫기 · 정지 버튼 = NPCStopTTSEvent로 읽던 음성을 멈춘다&lt;/span&gt;" vertex="1">
          <mxGeometry height="285" width="480" x="620" y="820" as="geometry" />
        </mxCell>
        <mxCell id="Aa8-t9vdycKFl_PdQedX-1" edge="1" parent="1" source="c24" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;rounded=0;defaultLabelBackgroundColor=page;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" target="c16" value="">
