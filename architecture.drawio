        <mxCell id="hD" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="D. 컴패니언 — 몬스터와 같은 모양이지만 상속하지 않는 별개의 상태 머신" vertex="1">
          <mxGeometry height="31" width="1500" x="40" y="1575" as="geometry" />
        </mxCell>
        <mxCell id="zCo" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fillOpacity=28;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" value="&lt;span style=&quot;font-size:15px&quot;&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="400" width="1600" x="40" y="1615" as="geometry" />
        </mxCell>
        <mxCell id="o1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;① 영입을 요청한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ NetworkCompanionCommands&lt;br&gt;.CmdRecruit()&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="300" x="60" y="1655" as="geometry" />
        </mxCell>
        <mxCell id="o2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;② 프리팹을 만들어 스폰한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ CompanionFactory.Create()&lt;br&gt;Instantiate · NetworkServer.Spawn&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="300" x="420" y="1655" as="geometry" />
        </mxCell>
        <mxCell id="o3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ 주인을 알려 주면 AI가 켜진다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ ICompanionServerState&lt;br&gt;.Initialize(owner)&lt;br&gt;프리팹엔 꺼져 있다&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="330" x="780" y="1655" as="geometry" />
        </mxCell>
        <mxCell id="o4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;CompanionServerState — 클라이언트에도 있다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;HP · 생존 · 소환 여부 · 주인을 SyncVar로 동기화한다&lt;br&gt;죽은 채 소환 해제하면 다시 불러도 죽은 채로 나온다&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="450" x="1170" y="1655" as="geometry" />
        </mxCell>
        <mxCell id="eD1" edge="1" parent="1" source="o1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="o2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eD2" edge="1" parent="1" source="o2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="o3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Follow — 주인을 따라간다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ CompanionAI.UpdateFollow()&lt;br&gt;주인과 FollowDistanceThreshold 이상&lt;br&gt;떨어지면 주인 위치로 간다&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="60" y="1835" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Chase — 몬스터를 쫓는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ CompanionAI.UpdateChase()&lt;br&gt;몬스터가 주인에게서 MaxChaseDistance&lt;br&gt;이내일 때만. 호위가 우선이다&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="510" y="1835" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Attack — 공격한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ CompanionAI.UpdateAttack()&lt;br&gt;CompanionHitbox.OnAttackHit()로 판정&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="960" y="1835" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Dead&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;어느 상태에서든&lt;br&gt;Died면 온다&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="210" x="1410" y="1835" as="geometry" />
        </mxCell>
        <mxCell id="eD3" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" target="d2" value="MonsterDetected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eD4" edge="1" parent="1" source="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" target="d1" value="MonsterLost">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eD5" edge="1" parent="1" source="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" target="d3" value="TargetInRange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eD6" edge="1" parent="1" source="d3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" target="d2" value="TargetOutOfRange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eD7" edge="1" parent="1" source="d3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="d4" value="Died">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;적과 아군은 Faction(진영)으로 가른다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;몬스터는 Faction이 Player인 대상(플레이어 · 컴패니언)만 노린다. 컴패니언도 같은 씬 · 같은 방의 몬스터만 후보로 삼는다 (5페이지).&lt;/span&gt;" vertex="1">
          <mxGeometry height="83" width="790" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;AI는 MonoBehaviour다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;MonsterAI · CompanionAI는 NetworkBehaviour가 아니다. 서버에서만 조립되거나 켜지므로 판단은 서버에서만 일어난다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="83" width="790" x="850" y="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
