        <mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Idle — 기다린다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ MonsterAI.OnTriggerEnter()&lt;br&gt;감지 트리거에 들어온 Faction.Player만&lt;br&gt;후보가 된다. 같은 방(matchId)만&lt;/span&gt;" vertex="1">
          <mxGeometry height="112" width="330" x="60" y="685" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Chase — 쫓는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ MonsterAI.UpdateChase()&lt;br&gt;가장 가까운 후보로 이동한다. 대상이 죽거나&lt;br&gt;스폰 지점에서 너무 멀면(리쉬) 포기&lt;/span&gt;" vertex="1">
          <mxGeometry height="112" width="330" x="510" y="685" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=6;fontSize=14;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Attack — 공격한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;▸ MonsterAI.UpdateAttack()&lt;br&gt;스킬을 골라 실행한다. 사거리의 1.2배를&lt;br&gt;벗어나야 Chase로 돌아간다&lt;/span&gt;" vertex="1">
          <mxGeometry height="112" width="330" x="960" y="685" as="geometry" />
        </mxCell>
