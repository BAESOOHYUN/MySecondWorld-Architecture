        <mxCell id="c35" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Groq Cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;LLM: qwen/qwen3.8-27b (응답은 한 번에 수신)&lt;br&gt;STT: Whisper (HTTPS POST)&lt;/span&gt;" vertex="1">
          <mxGeometry height="87" width="320" x="70" y="1352" as="geometry" />
