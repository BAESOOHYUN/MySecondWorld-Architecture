        <mxCell id="c17" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;도착한 자리에서 폭발한다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ ProjectileSplashCast&lt;br&gt;(도착 위치가 폭발 중심)&lt;/span&gt;" vertex="1">
          <mxGeometry height="87" width="260" x="80" y="588" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;대상 하나만 고른다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ SingleTargetSelector&lt;/span&gt;" vertex="1">
          <mxGeometry height="69" width="260" x="450" y="426" as="geometry" />
        </mxCell>
        <mxCell id="c19" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;범위 안 전부를 고른다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ CircleAoESelector&lt;/span&gt;" vertex="1">
          <mxGeometry height="69" width="260" x="450" y="507" as="geometry" />
        </mxCell>
        <mxCell id="c20" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;고정 피해를 준다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ DamageEffect&lt;/span&gt;" vertex="1">
          <mxGeometry height="69" width="260" x="820" y="426" as="geometry" />
        </mxCell>
        <mxCell id="c21" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;중심에서 멀수록 약한 피해를 준다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ SplashDamageEffect&lt;br&gt;(중심 100% → 반경 끝 0%)&lt;/span&gt;" vertex="1">
          <mxGeometry height="108" width="260" x="820" y="507" as="geometry" />
        </mxCell>
        <mxCell id="c22" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;dashed=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;확장 예시 (미구현)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;도트 피해 · 힐 · 버프/디버프&lt;/span&gt;" vertex="1">
          <mxGeometry height="69" width="260" x="820" y="627" as="geometry" />
        </mxCell>
        <mxCell id="c26" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;dashed=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;(확장 예정) 콤보 스킬&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;▸ ComboSkill (미구현)&lt;br&gt;ISkill을 구현해서 단일 스킬(SkillDefinition)과 콤보를 같은 타입으로 다루려는 자리. Composite 패턴.&lt;br&gt;지금 코드에는 ComboSkill 클래스가 없고, ISkill 계약만 먼저 만들어 두었다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="1040" x="60" y="732" as="geometry" />
