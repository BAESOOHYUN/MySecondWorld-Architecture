        <mxCell id="c14" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;MySecondWorld.UI  (31파일)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;화면 UI 전체.&lt;br&gt;참조: Foundation · Network · Bundle · AI · Customization · Save · Inventory(.Items) · Interaction · Combat · ScriptableObject · Camera&lt;/span&gt;" vertex="1">
