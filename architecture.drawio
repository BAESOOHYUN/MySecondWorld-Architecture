        <mxCell id="c17" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;" value="4 · 전투" vertex="1">
          <mxGeometry height="26" width="190" x="40" y="734" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;MySecondWorld.Combat  (63파일)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;스킬 · 몬스터 · 투사체 · 컴패니언.&lt;br&gt;참조: Network · Character · Pool · Foundation · Inventory · Interaction&lt;/span&gt;" vertex="1">
          <mxGeometry height="87" width="1400" x="250" y="741" as="geometry" />
        </mxCell>
        <mxCell id="c19" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;" value="3 · 네트워크" vertex="1">
          <mxGeometry height="26" width="190" x="40" y="872" as="geometry" />
        </mxCell>
        <mxCell id="c20" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=13;" value="&lt;b style=&quot;font-size:14px&quot;&gt;MySecondWorld.Network  (47파일)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Mirror 서버/클라 서비스 · 인증 · 존/방 · 웹 리소스 캐시.&lt;br&gt;참조: Foundation · Bundle · Save · Customization · Character · Camera · ScriptableObject · Inventory(.Items)&lt;br&gt;외부: Mirror · UniTask · MessagePipe · VContainer · Addressables · Cleverous Vault · PDFRenderer&lt;/span&gt;" vertex="1">
