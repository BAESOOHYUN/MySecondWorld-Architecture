        <mxCell id="c36" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fillOpacity=35;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=15;" value="" vertex="1">
          <mxGeometry height="221" width="1820" x="40" y="897" as="geometry" />
